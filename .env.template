AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT_MODEL=
AZURE_OPENAI_API_VERSION=

# --- Video generation (core/video.py) ---
# Azure Speech resource used for text-to-speech narration. Only the key and
# region are required (Text-to-Speech is available in all Speech regions).
SPEECH_KEY=
SPEECH_REGION=

# Narration voice (default shown; leave blank to use it).
NARRATION_VOICE=en-US-AvaMultilingualNeural

# Video output settings (format is WxH). Smaller = faster renders, lower clarity.
# Common 16:9 options: 426x240 (240p), 640x360 (360p), 854x480 (480p),
#   1280x720 (720p, matches the native capture), 1920x1080 (1080p, final quality).
# For quick local iteration use 640x360 @ 15 fps (optionally with --dry-run to skip TTS).
VIDEO_RESOLUTION=1920x1080
# Frames per second. Higher = smoother motion, larger files, slower renders.
# Common options: 15 (draft/quick iteration), 24 (cinematic), 30 (default, smooth),
#   60 (very smooth, noticeably slower to render). 24-30 is plenty for UI demos.
VIDEO_FPS=30

# Background music is OFF by default. Set true and drop one or more royalty-free
# (CC0) tracks into assets/music/ to enable; one is picked at random per run and
# looped under the narration, automatically ducking below the speech.
# BG_MUSIC_VOLUME is the music level in the gaps (0.0-1.0); it dips under narration.
ENABLE_BG_MUSIC=false
BG_MUSIC_VOLUME=0.12

# --- Persistent storage (optional) ---
# When AZURE_STORAGE_CONNECTION_STRING is set, run artifacts sync to Azure Blob and
# per-run logs + job metadata go to Azure Table Storage (used even when running
# locally). Leave it blank to keep everything on the local filesystem under output/.
# Blob container names allow lowercase + digits + hyphens; table names must be
# alphanumeric only (no hyphens) and start with a letter.
AZURE_STORAGE_CONNECTION_STRING=
BLOB_CONTAINER_NAME=pitchpilot-runs
TABLE_LOGS_NAME=pitchpilotlogs
TABLE_JOBS_NAME=pitchpilotjobs

# --- Logging ---
# Verbosity for per-run logs (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
